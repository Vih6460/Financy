{
  "name": "@financy/backend", "private": true, "version": "1.0.0", "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --import tsx src/server.ts", "build": "tsc", "start": "node dist/server.js",
    "setup": "node --import tsx scripts/setup.ts && prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev", "db:studio": "prisma studio",
    "test": "node --import tsx --test --test-concurrency=1 tests/api.test.ts"
  },
  "dependencies": { "@prisma/client": "6.12.0", "graphql": "^16.11.0", "graphql-yoga": "^5.16.0", "jose": "^6.1.0", "dotenv": "^17.2.3", "zod": "^4.1.12" },
  "devDependencies": { "prisma": "6.12.0", "tsx": "^4.20.6", "typescript": "^5.9.3", "@types/node": "^24.10.0" }
}
